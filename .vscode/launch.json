{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-msedge",
            "name": "Launch Microsoft Edge (Frontend)",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "runtimeArgs": [
                "--remote-debugging-port=9222"
            ]
        },
        {
            "type": "pwa-msedge",
            "name": "Launch Microsoft Edge in headless mode",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "runtimeArgs": [
                "--headless",
                "--remote-debugging-port=9222"
            ]
        },
        {
            "type": "vscode-edge-devtools.debug",
            "name": "Open Edge DevTools",
            "request": "attach",
            "url": "http://localhost:5173"
        },
        {
            "type": "python",
            "name": "Python: FastAPI (DDD Backend)",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend/DDD",
            "python": "${workspaceFolder}/backend/DDD/.venv/Scripts/python.exe",
            "justMyCode": true
        },
        {
            "type": "python",
            "name": "Python: FastAPI (MVC Backend)",
            "request": "launch",
            "program": "${workspaceFolder}/backend/MVC/main_mvc.py",
            "cwd": "${workspaceFolder}/backend/MVC",
            "python": "${workspaceFolder}/backend/MVC/.venv/Scripts/python.exe",
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "Launch Edge and attach DevTools",
            "configurations": [
                "Launch Microsoft Edge (Frontend)",
                "Open Edge DevTools"
            ]
        },
        {
            "name": "Launch Full Stack (DDD + Edge Frontend)",
            "configurations": [
                "Python: FastAPI (DDD Backend)",
                "Launch Microsoft Edge (Frontend)"
            ]
        }
    ]
}
