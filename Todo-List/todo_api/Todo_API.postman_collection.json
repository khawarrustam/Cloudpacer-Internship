		{
			"name": "📋 Todos",
			"item": [
				{
					"name": "Create Todo - HIGH priority",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has correct fields', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('id');",
									"    pm.expect(json).to.have.property('title');",
									"    pm.expect(json).to.have.property('priority');",
									"    pm.expect(json).to.have.property('is_completed');",
									"    pm.expect(json.is_completed).to.eql(false);",
									"    pm.expect(json.priority).to.eql('HIGH');",
									"});",
									"",
									"// Save todo_id for later use",
									"var json = pm.response.json();",
									"pm.collectionVariables.set('todo_id', json.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Setup Firebase Firestore\",\n    \"priority\": \"HIGH\"\n}",
							"options": {
								"raw": { "language": "json" }
							}
						},
						"url": {
							"raw": "{{base_url}}/todos",
							"host": ["{{base_url}}"],
							"path": ["todos"]
						},
						"description": "Create a new todo with HIGH priority. The `todo_id` is automatically saved for subsequent requests."
					},
					"response": []
				},
