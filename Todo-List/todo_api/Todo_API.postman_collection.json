				{
					"name": "List All Todos",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is an array', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.be.an('array');",
									"    pm.expect(json.length).to.be.greaterThan(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/todos",
							"host": ["{{base_url}}"],
							"path": ["todos"]
						},
						"description": "Fetch all todos from the database."
					},
					"response": []
				},
				{
					"name": "Complete Todo",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Todo is marked as completed', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.is_completed).to.eql(true);",
									"    pm.expect(json.completed_at).to.not.be.null;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/todos/{{todo_id}}/complete",
							"host": ["{{base_url}}"],
							"path": ["todos", "{{todo_id}}", "complete"]
						},
						"description": "Mark the previously created todo as complete. Uses the `todo_id` saved from the Create request."
					},
					"response": []
				}
			]
		},
