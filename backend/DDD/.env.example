# =============================================================================
# BACKEND (DDD) ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to '.env' in backend/DDD and adjust values as needed.
# =============================================================================

# --- Application & Server Settings ---
# APP_NAME: FastAPI application title shown in Swagger docs (/docs)
APP_NAME=Todo DDD API

# APP_ARCHITECTURE: Architecture label returned by health check endpoint (GET /)
APP_ARCHITECTURE=DDD

# BACKEND_HOST: Server IP address to bind (127.0.0.1 for localhost, 0.0.0.0 for container/network)
BACKEND_HOST=127.0.0.1

# BACKEND_PORT: Port number on which the FastAPI backend will run
BACKEND_PORT=8000

# BACKEND_RELOAD: Automatically reload server when backend code changes (true in dev, false in prod)
BACKEND_RELOAD=true

# CORS_ORIGINS: Comma-separated frontend URLs allowed to make cross-origin requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LOG_LEVEL: Terminal log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Local Signed-Token Settings (custom HMAC token, not JWT) ---
# Local signed-token settings. Change the secret before public deployment.
AUTH_TOKEN_SECRET=todo-local-development-secret-change-before-production
AUTH_TOKEN_EXPIRE_MINUTES=1440

# --- Database Selection ---
# DATABASE: Select todo storage with firestore, mongodb, or postgresql
DATABASE=postgresql

# --- MongoDB Settings (used when DATABASE=mongodb) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=todoflow
MONGODB_TODO_COLLECTION=todos
MONGODB_USER_COLLECTION=users

# --- PostgreSQL Settings (used when DATABASE=postgresql) ---
POSTGRESQL_URL=postgresql://postgres:your-password@localhost:5432/todoflow

# --- Firestore Settings (used only when DATABASE=firestore) ---
# Auth bhi Firestore ke auth_users collection mein hoti hai; Firebase Auth use nahi hoti.
# FIREBASE_CREDENTIALS_PATH: Relative or absolute path to the Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# FIRESTORE_API_URL: Base REST URL for Google Cloud Firestore API (avoids Windows gRPC issues)
FIRESTORE_API_URL=https://firestore.googleapis.com/v1
# Standard Firestore database ID usually (default) hoti hai.
FIRESTORE_DATABASE_ID=(default)
# User profile path ka collection name.
FIRESTORE_USER_COLLECTION=users
# Custom login accounts yahan store hote hain.
FIRESTORE_AUTH_COLLECTION=auth_users
# Har user ke todo subcollection ka name.
FIRESTORE_TODO_COLLECTION=todos
# REST list request ek page mein maximum itne todos read karti hai.
FIRESTORE_PAGE_SIZE=1000
