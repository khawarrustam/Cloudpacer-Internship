# =============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to '.env' in frontend/ and adjust values as needed.
# =============================================================================

# VITE_API_URL: Base URL of the backend API used by Axios in client.js for all requests
VITE_API_URL=http://127.0.0.1:8000

# VITE_DEV_HOST: Host IP for the Vite development server (127.0.0.1 or localhost)
VITE_DEV_HOST=127.0.0.1

# VITE_DEV_PORT: Port number on which the Vite development server will listen
VITE_DEV_PORT=5173

# VITE_STRICT_PORT: If true, fails if 5173 is already in use instead of choosing a random port
VITE_STRICT_PORT=true
